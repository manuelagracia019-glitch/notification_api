DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notification_api?schema=public"
# Optional direct (unpooled) URL for Prisma migrations; app queries use DATABASE_URL.
DATABASE_URL_UNPOOLED=
PORT=3001
FRONTEND_URL=http://localhost:3000

# Required to protect notification delivery endpoints.
NOTIFICATION_API_TOKEN=
# Required to use the protected configuration and dashboard API.
ADMIN_API_TOKEN=
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Gmail account and 16-character Google app password.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=

# Vonage SMS credentials.
VONAGE_API_KEY=
VONAGE_API_SECRET=

# SMS sender ID configured for your Vonage account and destination country.
VONAGE_SMS_SENDER=
